{
  "title": "二分探索：t = 23 を探す",
  "slug": "binary-search",
  "width": 1000,
  "height": 560,
  "elements": [
    {"id": "arr", "type": "array", "x": 230, "y": 70, "cell": 54, "label": "a", "values": [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]},
    {"id": "lo", "type": "pointer", "array": "arr", "index": 0, "label": "lo", "side": "bottom", "color": "ok", "show": 2},
    {"id": "hi", "type": "pointer", "array": "arr", "index": 9, "label": "hi", "side": "bottom", "color": "bad", "show": 2},
    {"id": "mid", "type": "pointer", "array": "arr", "index": 4, "label": "mid", "side": "top", "color": "accent", "show": 4},
    {"id": "code", "type": "code", "x": 60, "y": 250, "size": 16, "title": "search.py", "lines": [
      "def search(a, t):",
      "    lo, hi = 0, len(a) - 1",
      "    while lo <= hi:",
      "        mid = (lo + hi) // 2",
      "        if a[mid] == t: return mid",
      "        if a[mid] < t: lo = mid + 1",
      "        else: hi = mid - 1",
      "    return -1"
    ]},
    {"id": "t", "type": "text", "x": 700, "y": 270, "text": "t = 23", "align": "start", "size": 22, "weight": "600"},
    {"id": "nlo", "type": "number", "x": 700, "y": 320, "value": 0, "prefix": "lo = ", "align": "start", "color": "ok", "show": 2},
    {"id": "nhi", "type": "number", "x": 700, "y": 360, "value": 9, "prefix": "hi = ", "align": "start", "color": "bad", "show": 2},
    {"id": "nmid", "type": "number", "x": 700, "y": 400, "value": 4, "prefix": "mid = ", "align": "start", "color": "accent", "show": 4},
    {"id": "nrange", "type": "number", "x": 700, "y": 460, "value": 10, "prefix": "残り候補 ", "suffix": " 個", "align": "start", "size": 26, "show": 2}
  ],
  "steps": [
