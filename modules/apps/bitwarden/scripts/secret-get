# secret-get — D1（Bitwarden）の値を rbw から取る、消費スクリプト用の共通入口。
#
# ## なぜ1本にまとめるか（2026-10-13・rbw の統一）
#
# それまで消費側がそれぞれ `rbw get` を直に叩いていて、作法がばらばらだった
# （解錠確認あり／なし、timeout あり／なし、失敗時の案内あり／なし）。
# 特に危ないのは**施錠中に `rbw get` を叩く**こと：rbw-agent が pinentry を起動して
# 待つので、tty の無い呼び出し元（subprocess・launchd）はそこで固まる。
# pinentry が curses になった（2026-10-02）いまは、ダイアログが出ないぶん余計に見えない。
# → ここでは**絶対に解錠を試みない**。施錠中なら案内を出して exit 4。
#
# ## Keychain は読まない
#
# 手動で使うツールは rbw 直読み（vault の macos-secret-management の判定式「無人ジョブが
# 読むか？ No → rbw 直読み」）。しかも ssh 越しのセッションからは login Keychain を
# 開けず**読めない**（2026-10-13 実測：default-keychain は System を指し、
# show-keychain-info は "User interaction is not allowed"）。
# AI の実行ホストは ssh で入る母艦なので（2026-10-02-ai-host-consolidation）、Keychain に
# 頼る手動ツールはそこで必ず「無い」に見える。launchd 用のキャッシュは secret-cache を参照。
#
# ## 使い方（消費スクリプトの中から呼ぶ。値は stdout に1行で出る）
#
#   TOKEN=$(secret-get canvas-open-api) || exit 4
#   USER=$(secret-get --field username txst)
#
# ★ Claude が直接叩くのは deny（modules/apps/claude/deny-secret-reads.sh）。
#   `rbw get` と同じく平文が stdout に出るため。値を使う処理は消費スクリプトに読ませる。
#
# 終了コード: 0 成功 / 2 引数不正 / 4 取れない（rbw 無し・施錠中・エントリ無し・空）

set -euo pipefail

die() {
    printf 'secret-get: %s\n' "$1" >&2
    exit "${2:-4}"
}

FIELD=""
while [ $# -gt 0 ]; do
    case "$1" in
        --field) [ $# -ge 2 ] || die "--field にフィールド名が要る" 2; FIELD="$2"; shift 2 ;;
        -h|--help) sed -n '2,/^$/p' "$0" 2>/dev/null || true; exit 0 ;;
        --) shift; break ;;
        -*) die "不明なオプション: $1" 2 ;;
        *) break ;;
    esac
done
[ $# -eq 1 ] || die "usage: secret-get [--field NAME] <bitwarden-entry>" 2
ENTRY="$1"

command -v rbw >/dev/null 2>&1 || die "rbw が無い（darwin-rebuild switch は済んでる？）"

if ! rbw unlocked >/dev/null 2>&1; then
    printf 'secret-get: Bitwarden がロック中（%s を取れない）。\n' "$ENTRY" >&2
    printf '  → 端末で `rbw unlock`（この機体が初回なら `rbw register` → `rbw login`。\n' >&2
    printf '    手順は vault の runbook-bitwarden-rbw）\n' >&2
    exit 4
fi

args=(get)
[ -n "$FIELD" ] && args+=(--field "$FIELD")
# rbw の stderr は通す（「無い」以外の失敗＝同名複数・sync 不良などを潰さないため）。
# rbw のエラー文に値は含まれない（項目名・ユーザー名までは出うる。2026-10-14 監査）。
#
# rbw 自身に時間制限を掛ける。`rbw unlocked` と `rbw get` の間で施錠されると rbw が
# pinentry を待って固まり、呼び出し側の timeout は secret-get しか殺さないので
# rbw が孤児で残る（2026-10-14 監査で実証）。perl の alarm＋exec は rbw 自身を
# SIGALRM で殺す。macOS に coreutils の timeout は標準で無いので /usr/bin/perl を使う。
VALUE=$(/usr/bin/perl -e 'alarm shift; exec @ARGV or die "exec: $!\n"' 20 \
            rbw "${args[@]}" "$ENTRY") \
    || die "Bitwarden から '$ENTRY' を取れない（上の rbw のエラーを見る。無いなら \`rbw sync\` → \`rbw list\` で名前を確認）"
[ -n "$VALUE" ] || die "'$ENTRY' の ${FIELD:-password} が空"

printf '%s\n' "$VALUE"
