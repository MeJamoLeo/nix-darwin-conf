# secret-cache — D1（Bitwarden）の値を login Keychain に「派生キャッシュ」として落とす。
#
# ## 役割（vault の macos-secret-management の判定式）
#
# 「無人ジョブが読むか？ Yes → D1 正史＋Keychain は再生成可能な派生キャッシュ」。
# launchd のジョブは pinentry を出せず、rbw-agent は再起動で死ぬので rbw を当てにできない。
# だから launchd 用には Keychain に写しを置く。★本当の負債は Keychain の存在ではなく
# 「そこにしか無い」こと——正史は Bitwarden に置き、Keychain はこのコマンドでいつでも
# 作り直せる状態に保つ。新しい機体ではこれを1回流せば launchd 側が揃う。
#
# ## 使い方（GUI ログインしている端末で実行する）
#
#   secret-cache canvas-open-api canvas-txst-token     # todo-board
#   secret-cache atcoder-revel-session atcoder-revel-session   # cp stopwatch
#   secret-cache --account-from-entry novisteps novisteps-password   # cp dashboard
#
#   --account-from-entry  Keychain 項目の account に Bitwarden の username を入れる
#                         （novisteps のように account をログイン名として読む消費者用）。
#                         無指定なら account は $USER。
#
# ssh 越しのセッションでは login Keychain に書けない（開くのに対話が要る。2026-10-13
# 実測）。その場合は案内を出して exit 5——Mac の前の端末で流し直す。
#
# 承知の上のトレードオフ: `security add-generic-password -w <値>` は値を argv に ~1秒載せる
# （cp-login / fetch_novisteps と同じ判断。単一ユーザ機）。`-T /usr/bin/security` は
# launchd から無確認で読ませるため（同上）。stdout には何も出さない。
#
# 終了コード: 0 成功 / 2 引数不正 / 4 rbw から取れない / 5 Keychain に書けない

set -euo pipefail

die() {
    printf 'secret-cache: %s\n' "$1" >&2
    exit "${2:-2}"
}

ACCOUNT_FROM_ENTRY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --account-from-entry) ACCOUNT_FROM_ENTRY=1; shift ;;
        -h|--help) sed -n '2,/^$/p' "$0" 2>/dev/null || true; exit 0 ;;
        --) shift; break ;;
        -*) die "不明なオプション: $1" ;;
        *) break ;;
    esac
done
[ $# -eq 2 ] || die "usage: secret-cache [--account-from-entry] <bitwarden-entry> <keychain-service>"
ENTRY="$1"
SERVICE="$2"

# 書けるかを先に確かめる（値を取り出す前に止まるため）。ssh 越しだと login Keychain は
# user の検索リストには居るが開けない（show-keychain-info が "User interaction is not
# allowed" で落ち、書き込みは -61 になる。2026-10-13 実測）。施錠中も同じくここで止まる。
# 判定が外れても下の add-generic-password の失敗を exit 5 で拾う。
if ! security show-keychain-info "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1; then
    printf 'secret-cache: login Keychain を開けない（ssh 越し、または施錠中）。\n' >&2
    printf '  → Mac の前の端末で `secret-cache %s %s` を流し直して\n' "$ENTRY" "$SERVICE" >&2
    exit 5
fi

VALUE=$(secret-get "$ENTRY") || exit 4
ACCOUNT="$USER"
if [ "$ACCOUNT_FROM_ENTRY" -eq 1 ]; then
    ACCOUNT=$(secret-get --field username "$ENTRY") || exit 4
fi

security add-generic-password -U -a "$ACCOUNT" -s "$SERVICE" -T /usr/bin/security -w "$VALUE" \
    || die "Keychain への書き込みに失敗（service=${SERVICE}）" 5
unset VALUE

printf 'secret-cache: %s → Keychain(service=%s) を更新した\n' "$ENTRY" "$SERVICE" >&2
