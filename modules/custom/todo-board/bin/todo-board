#!/usr/bin/env python3
"""todo-board launcher — 本体は todo_board パッケージ（todo_board/cli.py の main）。

パッケージの探し方（先に見つかったものを使う）:
  1. env TODO_BOARD_PKG（todo_board/ を含むディレクトリ。todo_board/ 自身を指してもよい。テスト／開発用）
  2. このファイルの隣（リポジトリ内で直接実行したとき: bin/../todo_board）
  3. ~/.local/lib/todo-board（home.nix が配置する場所）
"""
import os
import sys


def _roots():
    env = os.environ.get("TODO_BOARD_PKG")
    if env:
        env = os.path.expanduser(env)
        yield os.path.dirname(os.path.abspath(env)) if os.path.basename(os.path.abspath(env)) == "todo_board" else env
    yield os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    yield os.path.expanduser("~/.local/lib/todo-board")


for _r in _roots():
    if os.path.isfile(os.path.join(_r, "todo_board", "__init__.py")):
        sys.path.insert(0, _r)
        break

from todo_board.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
