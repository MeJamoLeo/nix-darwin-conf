#!/usr/bin/env bash
# desktop-switch — デスクトップ壁紙レイヤーを alt+N で切替する tiny dispatcher。
#
# サブコマンド:
#   desktop-switch <layer> [--all]      表示切替
#       layer: wallpaper | caldash | cp
#       --all: 全画面に一括適用（既定は aerospace の focused monitor のみ）
#   desktop-switch reload <layer>       kickstart で dashboard を再起動
#       表示状態（state file）は変更しない。再起動後の app が state を読み直して復元。
#
# 動作原理:
#   1. active monitor 名を aerospace list-monitors --focused から取得（--all なら "all"）
#      ※ aerospace の monitor-id は独自順で NSScreen の index と一致しないため、
#        識別子は monitor-name を使う（Swift 側で NSScreen.localizedName と照合）。
#   2. 命令ファイル ~/.local/state/desktop-switch/cmd に "layer=X;screen=Y" を書く
#      （Y は monitor-name または "all"）
#   3. 両 dashboard に SIGUSR1 → 各 app が cmd を読んで自身の該当 window を show/hide
#      （自 layer なら show、そうでなければ hide）
#   4. 表示状態を state file に per-screen（key=monitor-name）で永続化（reload 後の復元用）
#
# 呼び出し例（aerospace binding から）:
#   desktop-switch wallpaper            # active monitor だけ壁紙
#   desktop-switch wallpaper --all      # 全モニタ壁紙
#   desktop-switch caldash              # active monitor だけ caldash
#   desktop-switch reload cp            # cp を kickstart、表示状態は保持

set -euo pipefail

readonly LABEL_CALDASH="org.nix-community.home.com.treo.calendar-dashboard-live"
readonly LABEL_CP="org.nix-community.home.com.treo.cp-dashboard-live"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-switch"
readonly CMD_FILE="$STATE_DIR/cmd"
readonly STATE_FILE="$STATE_DIR/state"

pid_of() {
  /bin/launchctl list "$1" 2>/dev/null | awk '/"PID"/ {gsub(/[";,]/,""); print $NF}'
}

# --- reload subcommand ---
if [[ "${1:-}" == "reload" ]]; then
  case "${2:-}" in
    caldash) label="$LABEL_CALDASH" ;;
    cp)      label="$LABEL_CP" ;;
    *) echo "usage: desktop-switch reload {caldash|cp}" >&2; exit 2 ;;
  esac
  /bin/launchctl kickstart -k "gui/$(id -u)/$label" >/dev/null 2>&1 || true
  exit 0
fi

# --- 表示切替 subcommand ---
layer="${1:-}"
all=0
[[ "${2:-}" == "--all" ]] && all=1

case "$layer" in
  wallpaper|caldash|cp) ;;
  *) echo "usage: desktop-switch {wallpaper|caldash|cp} [--all] | reload {caldash|cp}" >&2; exit 2 ;;
esac

# active monitor 名（"1 | Mi TV" → "Mi TV"）。--all なら "all"。
if [[ $all == 1 ]]; then
  screen="all"
else
  screen="$(aerospace list-monitors --focused 2>/dev/null | sed -E 's/^[0-9]+ \| //' | head -1)"
  [[ -z "$screen" ]] && { echo "desktop-switch: failed to get focused monitor" >&2; exit 3; }
fi

mkdir -p "$STATE_DIR"
printf 'layer=%s;screen=%s\n' "$layer" "$screen" > "$CMD_FILE"

# 両 app に SIGUSR1（cmd file を読ませる）
for label in "$LABEL_CALDASH" "$LABEL_CP"; do
  pid="$(pid_of "$label")"
  [[ -n "$pid" ]] && /bin/kill -USR1 "$pid" 2>/dev/null || true
done

# state file 更新（key = monitor-name）
touch "$STATE_FILE"
if [[ $screen == "all" ]]; then
  # aerospace から全 monitor 名を取得して 1 行ずつ書き直す
  tmp="$(mktemp)"
  aerospace list-monitors 2>/dev/null | sed -E 's/^[0-9]+ \| //' | while read -r name; do
    [[ -n "$name" ]] && printf '%s=%s\n' "$name" "$layer" >> "$tmp"
  done
  mv "$tmp" "$STATE_FILE"
else
  # 単一 screen: 該当 name の行を差し替え
  tmp="$(mktemp)"
  grep -v "^${screen}=" "$STATE_FILE" > "$tmp" 2>/dev/null || true
  printf '%s=%s\n' "$screen" "$layer" >> "$tmp"
  sort "$tmp" > "$STATE_FILE"
  rm -f "$tmp"
fi
