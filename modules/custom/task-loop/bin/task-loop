#!/usr/bin/env python3
"""task-loop <job> [--dry-run]

jobs:
  workspace-cleanup   Linear の状態に合わせて Orca のワークスペースを片付ける
  agent-pick          無人 automation が次に処理する Agent issue を選ぶ（--check で precheck）
"""

import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/task-loop"))

JOBS = {
    "workspace-cleanup": "task_loop.cleanup",
    "agent-pick": "task_loop.agent_pick",
}


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help") or sys.argv[1] not in JOBS:
        print(__doc__.strip())
        return 0 if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help") else 2
    import importlib

    mod = importlib.import_module(JOBS[sys.argv[1]])
    return mod.main(sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
